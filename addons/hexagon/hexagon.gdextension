[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.4
reloadable = true

[libraries]
linux.debug.x86_64 =     "res://addons/hexagon/target/debug/libhexagon.so"
linux.release.x86_64 =   "res://addons/hexagon/target/release/libhexagon.so"
windows.debug.x86_64 =   "res://addons/hexagon/target/debug/hexagon.dll"
windows.release.x86_64 = "res://addons/hexagon/target/release/hexagon.dll"
macos.debug =            "res://addons/hexagon/target/debug/libhexagon.dylib"
macos.release =          "res://addons/hexagon/target/release/libhexagon.dylib"
macos.debug.arm64 =      "res://addons/hexagon/target/debug/libhexagon.dylib"
macos.release.arm64 =    "res://addons/hexagon/target/release/libhexagon.dylib"
